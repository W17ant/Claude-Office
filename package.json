{
  "name": "@w17ant/agent-office",
  "productName": "Agent Office",
  "version": "1.1.2",
  "description": "Pixel art office visualization for AI agents powered by Claude Code hooks",
  "author": "W17ANT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/W17ant/Claude-Office.git"
  },
  "homepage": "https://github.com/W17ant/Claude-Office",
  "bugs": "https://github.com/W17ant/Claude-Office/issues",
  "type": "module",
  "bin": {
    "agent-office": "cli/agent-office.mjs"
  },
  "files": [
    "cli/",
    "server/",
    "dist/",
    "hooks/",
    "scripts/open-office.mjs",
    "scripts/doctor.mjs",
    "scripts/stop-office.sh",
    "electron/helpers.cjs",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"sleep 2 && electron .\"",
    "dev:all": "concurrently \"node server/index.js\" \"vite\"",
    "build": "tsc && vite build",
    "build:electron": "vite build && electron-builder",
    "pack": "vite build && electron-builder --dir",
    "electron": "electron .",
    "start": "npm run dev:electron",
    "server": "node server/index.js",
    "lan": "node scripts/lan.mjs",
    "open": "node scripts/open-office.mjs",
    "rotate-token": "node scripts/rotate-token.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-assets": "node scripts/check-assets.mjs",
    "install-hooks": "bash hooks/install-hooks.sh",
    "install-status-line": "bash hooks/install-hooks.sh --status-line-only",
    "uninstall-hooks": "bash hooks/install-hooks.sh --uninstall",
    "doctor": "node scripts/doctor.mjs",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.8.11",
    "express": "^4.19.2",
    "qrcode-terminal": "0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.agentoffice.app",
    "productName": "Agent Office",
    "extraMetadata": {
      "name": "agent-office"
    },
    "artifactName": "Agent-Office-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist/**",
      "electron/**",
      "!electron/after-pack.cjs",
      "server/**",
      "scripts/notify.sh"
    ],
    "npmRebuild": false,
    "afterPack": "electron/after-pack.cjs",
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  }
}
